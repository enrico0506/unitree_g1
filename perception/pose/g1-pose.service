# People-pose service for the G1 dashboard (staged; install in Phase 4 after validation).
#
# Install:
#   sudo cp /home/unitree/projects/g1/perception/pose/g1-pose.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now g1-pose      # enable only once validated
#
# Runs the pose container; reads /dev/shm/g1_camera.jpg, writes /dev/shm/g1_pose.jpg.
# Independent of g1-web: if this is stopped, the raw camera feed/dashboard are unaffected.

[Unit]
Description=G1 people-pose (YOLO11-pose) annotator
After=docker.service g1-web.service
Requires=docker.service

[Service]
Type=simple
# Clear any stale container, then run in the foreground so systemd tracks it.
ExecStartPre=-/usr/bin/docker rm -f g1-pose
ExecStart=/home/unitree/projects/g1/perception/pose/run_pose.sh
ExecStop=-/usr/bin/docker stop g1-pose
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
