# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Model weights (large, downloadable pretrained models — not source) ---
# e.g. perception/detect/models/clip/ViT-B-32.pt is 337 MB (> GitHub's 100 MB limit).
# See the READMEs for how to obtain these. Regenerate/re-download into */models/.
*.pt
*.pth
*.onnx
*.engine
perception/*/models/

# --- Generated map data (re-created by running the mapper) ---
maps/*.npy
maps/*.ply

# --- Debug / test capture frames ---
perception/pose/*test*.jpg
perception/**/*_test*.jpg

# --- Local, machine-specific Claude Code settings ---
.claude/settings.local.json

# --- OS / editor cruft ---
.DS_Store
*.swp
*~

# runtime UI settings (suppress_autoclimb etc.)
state/

# --- Sim (Track B): isolated venv + vendored mujoco G1 model ---
# g1.xml/g1_with_hands.xml + meshes are ~38 MB, fetched from
# google-deepmind/mujoco_menagerie (BSD-3-Clause) by sim/fetch_model.sh -- not
# source, re-download rather than bloat repo git history. See sim/models/README.md.
sim/.venv/
sim/models/g1/

# --- Runtime debug cruft ---
MUJOCO_LOG.TXT
